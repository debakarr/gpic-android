<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except the DJI camera's own file server on its WiFi (plain HTTP, local only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.2.1</domain>
    </domain-config>
</network-security-config>
